{
  "openapi": "3.1.0",
  "info": {
    "title": "LG TUNE",
    "version": "0.1.0"
  },
  "paths": {
    "/api/schedules/{senior_id}": {
      "get": {
        "tags": [
          "schedules"
        ],
        "summary": "Get Schedule",
        "operationId": "get_schedule_api_schedules__senior_id__get",
        "parameters": [
          {
            "name": "senior_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Senior Id"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup": {
      "post": {
        "summary": "Setup",
        "operationId": "setup_api_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plan/today": {
      "get": {
        "summary": "Plan Today",
        "operationId": "plan_today_api_plan_today_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "description": "사용자가 한 말"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ChatRequest",
        "description": "글자로 AI 친구에게 말 걸기 (음성 연결 전 1단계)."
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "AI 친구의 답"
          },
          "fallback": {
            "type": "boolean",
            "title": "Fallback",
            "description": "true = AI가 제때 답하지 못해 고정 멘트로 답함"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "fallback"
        ],
        "title": "ChatResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "profile": {
            "type": "string",
            "title": "Profile"
          },
          "llm": {
            "type": "string",
            "title": "Llm"
          },
          "stt": {
            "type": "string",
            "title": "Stt"
          },
          "tts": {
            "type": "string",
            "title": "Tts"
          }
        },
        "type": "object",
        "required": [
          "status",
          "profile",
          "llm",
          "stt",
          "tts"
        ],
        "title": "Health"
      },
      "PlanItem": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "program_id": {
            "type": "string",
            "title": "Program Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "고른 이유 (화면 표시용, 예: '트로트 좋아하셔서')"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "reminded",
              "accepted",
              "declined",
              "playing",
              "done",
              "skipped"
            ],
            "title": "Status",
            "default": "planned"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "start",
          "end",
          "channel",
          "program_id",
          "title",
          "reason"
        ],
        "title": "PlanItem"
      },
      "PlanResponse": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PlanItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "date",
          "items"
        ],
        "title": "PlanResponse"
      },
      "ScheduleItem": {
        "properties": {
          "program_id": {
            "type": "string",
            "title": "Program Id"
          },
          "channel_id": {
            "type": "string",
            "title": "Channel Id",
            "description": "예: 'KBS1'"
          },
          "channel_number": {
            "type": "integer",
            "title": "Channel Number",
            "description": "리모컨 채널 번호"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start",
            "description": "한국 시간, 시간대 표기 없음"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "엔진 점수 (fill 이면 0)"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "화면에 보여 줄 고른 이유"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pick",
              "fill"
            ],
            "title": "Kind",
            "description": "pick = 점수로 고름, fill = 빈 시간 채움"
          }
        },
        "type": "object",
        "required": [
          "program_id",
          "channel_id",
          "channel_number",
          "title",
          "start",
          "end",
          "score",
          "reason",
          "kind"
        ],
        "title": "ScheduleItem",
        "description": "하루표의 한 칸 (마이모드)."
      },
      "ScheduleResponse": {
        "properties": {
          "senior_id": {
            "type": "string",
            "title": "Senior Id"
          },
          "date": {
            "type": "string",
            "title": "Date",
            "description": "YYYY-MM-DD"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScheduleItem"
            },
            "type": "array",
            "title": "Items",
            "description": "시작 시각 순, 서로 겹치지 않음"
          }
        },
        "type": "object",
        "required": [
          "senior_id",
          "date",
          "items"
        ],
        "title": "ScheduleResponse"
      },
      "SetupRequest": {
        "properties": {
          "call_name": {
            "type": "string",
            "title": "Call Name",
            "description": "AI 친구가 부를 호칭 (예: '어머니', '영숙 님')"
          },
          "wake_time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "title": "Wake Time",
            "default": "06:30"
          },
          "sleep_time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "title": "Sleep Time",
            "default": "22:00"
          },
          "favorite_genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Favorite Genres",
            "description": "예: ['트로트', '사극']"
          },
          "favorite_people": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Favorite People",
            "description": "좋아하는 가수·배우"
          },
          "religion": {
            "type": "string",
            "enum": [
              "none",
              "christian",
              "catholic",
              "buddhist"
            ],
            "title": "Religion",
            "default": "none"
          }
        },
        "type": "object",
        "required": [
          "call_name"
        ],
        "title": "SetupRequest",
        "description": "자녀 폰 첫 설정."
      },
      "SetupResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          }
        },
        "type": "object",
        "title": "SetupResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
