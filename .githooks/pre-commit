#!/bin/sh
# 1) main 에서 바로 커밋하는 실수 방지  2) API 키·.env 커밋 방지
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ "$ALLOW_MAIN_PUSH" != "1" ]; then
  echo "  ✋ main 에서 바로 커밋하지 말고 브랜치를 먼저 만드세요:  git switch -c feat/작업이름"
  echo "     (지금 고친 내용은 그대로 따라옵니다)"
  exit 1
fi
if git diff --cached --name-only | grep -E '(^|/)\.env$|keys\.txt$' >/dev/null; then
  echo "  ✋ .env / keys.txt 는 커밋하면 안 돼요 (API 키 유출). git restore --staged <파일> 로 빼주세요."
  exit 1
fi
if git diff --cached -U0 | grep -E '^\+.*(sk-ant-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9]{20,})' >/dev/null; then
  echo "  ✋ 커밋 내용에 API 키로 보이는 값이 있어요. 지우고 backend/.env 에만 넣어주세요."
  exit 1
fi
exit 0
