# 이 파일을 복사해서 backend/.env 로 저장한 뒤 값을 채우세요. (.env 는 Git에 안 올라감)
PROFILE=dev
LLM_PROVIDER=fake          # fake | claude | openai
LLM_FALLBACK=none          # none | qwen_local | exaone
JUDGE_PROVIDER=fake        # fake | local(직접 학습) | jev | claude
STT_PROVIDER=fake          # fake | whisper
TTS_PROVIDER=fake          # fake | supertonic | custom
CHAT_ENABLED=true          # 대화 기능 켜기/끄기
LLM_TIMEOUT_S=3            # 이 초를 넘으면 고정 멘트로 답
CLOCK_SPEED=1
DEMO_MODE=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=              # 예: 쓸 모델 이름 (OpenAI 문서에서 확인)
JEV_API_KEY=
