{
  "name": "lg-tune-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mock": "node mock/ws-replay.mjs",
    "gen:types": "openapi-typescript ../contracts/openapi.json -o src/shared/api/rest.ts && json2ts -i ../contracts/ws-events.schema.json -o src/shared/api/ws.ts --additionalProperties false",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "ws": "^8.23.0"
  },
  "packageManager": "pnpm@10.28.0"
}
